generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
}

model Usuario {
  id                   Int       @id @default(autoincrement())
  nombre_apellido      String
  dni                  String    @unique
  email                String?   @unique
  password_hash        String?
  reset_code_hash      String?
  reset_code_expires_at DateTime?
  device_id            String?
  device_fingerprint   Json?
  rol_id               Int
  rol                  Role      @relation(fields: [rol_id], references: [id])
  activo               Boolean   @default(true)
  device_registered_at DateTime?
  device_last_seen_at  DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  fichadas             Fichada[]
}

model Servicio {
  id                  Int       @id @default(autoincrement())
  nombre              String    @unique
  lat                 Float
  lon                 Float
  radio_metros        Int       @default(200)
  hora_entrada_limite String?
  tolerancia_turno_minutos Int   @default(60)
  activo              Boolean   @default(true)
  fichadas            Fichada[]
  turnos              ServicioTurno[]
}

model ServicioTurno {
  id          Int      @id @default(autoincrement())
  servicio_id Int
  servicio    Servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  hora_inicio String
  hora_fin    String?
  orden       Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([servicio_id, hora_inicio])
  @@index([servicio_id, orden, hora_inicio])
}

model Fichada {
  id          Int      @id @default(autoincrement())
  usuario_id  Int
  usuario     Usuario  @relation(fields: [usuario_id], references: [id])
  fecha       DateTime @db.Date
  entrada     DateTime?
  salida      DateTime?
  lat         Float
  lon         Float
  servicio_id Int
  servicio    Servicio @relation(fields: [servicio_id], references: [id])
  fingerprint Json?
  created_at  DateTime @default(now())
}
